# Copy to .env and fill in. Every variable is read by configs/settings.py.
# Non-secret variables are shown commented out with their code default.

# OpenRouter API key, created in your OpenRouter account. Optional: without it (or without
# remote AI consent in Settings) GoalOS answers from its local rule engine.
OPENROUTER_API_KEY=

# OpenRouter model slug used for coaching. Code default shown. On a timeout, rate limit or
# model error the client rotates through a built-in list of free models.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Path to the SQLite database. Default: goalos.db in the repository root.
# DB_PATH=<repository root>/goalos.db

# Directory of the ChromaDB vector store. Default: chroma_db in the repository root.
# CHROMA_PATH=<repository root>/chroma_db

# Defined in settings but not read by the current code.
# LOG_LEVEL=INFO

# Defined in settings but not read by the current code.
# LOG_FILE=<repository root>/goalos.log

# Bearer token required on every protected API route when set. Generate a long random string.
# Required when ENVIRONMENT=production (the app refuses to start without it).
# Leave empty for local use, where the API is open.
GOALOS_API_TOKEN=

# Deployment mode: development (default), demo or production.
#   demo       loads the fictional demo dataset at startup and uses hash embeddings
#              instead of sentence-transformers (this is what Cloud Run runs).
#   production requires GOALOS_API_TOKEN.
# ENVIRONMENT=development
