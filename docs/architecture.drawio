<mxfile host="app.diagrams.net" modified="2026-09-05T19:45:00.000Z" agent="GoalOS System Architect" version="21.6.8" type="device"><diagram id="page1" name="1. System Topology &amp; Layers"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1380" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1_title" value="&lt;b style='font-size:20px; color:#064E3B;'&gt;🎯 GoalOS — High-Level System Topology &amp; Layered Architecture&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px; color:#475569;'&gt;Local-First Cognitive Operating System • Multi-Horizon Execution • Multi-Agent Supervisor • Hybrid 5-Factor RAG Dual-Persistence&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Plus Jakarta Sans,sans-serif;" vertex="1" parent="1" x="40" y="20" width="1770" height="50" /><mxCell id="p1_c1" value="1. PRESENTATION PLANE (Client Desktop Web — React 18 + Vite + TypeScript @ Port 5173)&#10;Design Tokens: Forest Mist Paper Glass • Tailwind CSS 3 • Lucide Icons • Plus Jakarta Sans &amp; Newsreader" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="40" y="90" width="1770" height="180" /><mxCell id="p1_v_shell" value="&lt;b&gt;Command Shell &amp; Navbar&lt;/b&gt;&lt;br&gt;Global Horizon Bar&lt;br&gt;Quick Capture Drawer&lt;br&gt;Theme &amp; Status Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="60" y="140" width="180" height="110" /><mxCell id="p1_v_cal" value="&lt;b&gt;Life Calendar View&lt;/b&gt;&lt;br&gt;70-Year Lifespan Grid&lt;br&gt;Memento Mori Pacing&lt;br&gt;Week Block Modals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="260" y="140" width="180" height="110" /><mxCell id="p1_v_jrn" value="&lt;b&gt;Daily Journal &amp; Tasks&lt;/b&gt;&lt;br&gt;Morning / Evening Rituals&lt;br&gt;Habit Consistency Tracker&lt;br&gt;OCR &amp; Audio Ingest UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="460" y="140" width="190" height="110" /><mxCell id="p1_v_gl" value="&lt;b&gt;Multi-Horizon Goals&lt;/b&gt;&lt;br&gt;5-Yr Vision / 1-Yr Targets&lt;br&gt;1-Mo Execution Sprints&lt;br&gt;Milestone Progress Bars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="670" y="140" width="190" height="110" /><mxCell id="p1_v_coach" value="&lt;b&gt;AI Coach Studio&lt;/b&gt;&lt;br&gt;Multi-Turn Chat Studio&lt;br&gt;Live Blackboard Viewer&lt;br&gt;Telemetry &amp; Cost Meter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="880" y="140" width="200" height="110" /><mxCell id="p1_v_mem" value="&lt;b&gt;Cognitive Memories&lt;/b&gt;&lt;br&gt;Memory Feed &amp; Search&lt;br&gt;Hybrid RAG Inspection&lt;br&gt;Importance &amp; Access Stats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1100" y="140" width="190" height="110" /><mxCell id="p1_v_anl" value="&lt;b&gt;Analytics &amp; Patterns&lt;/b&gt;&lt;br&gt;Longitudinal Health Scores&lt;br&gt;Stalling / Burnout Alerts&lt;br&gt;Velocity Heatmaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1310" y="140" width="190" height="110" /><mxCell id="p1_v_set" value="&lt;b&gt;Settings &amp; Privacy&lt;/b&gt;&lt;br&gt;Remote AI Opt-in Toggle&lt;br&gt;OpenRouter API Key Form&lt;br&gt;JSON Export &amp; Safe Reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1520" y="140" width="180" height="110" /><mxCell id="p1_api_client" value="&lt;b&gt;Axios API Client&lt;/b&gt;&lt;br&gt;&lt;code&gt;frontend/src/api/client.ts&lt;/code&gt;&lt;br&gt;Type-Safe Fetchers &amp; Error Interceptors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="1720" y="140" width="70" height="110" /><mxCell id="p1_c2" value="2. API GATEWAY &amp; SECURITY PLANE (FastAPI REST Engine @ Port 8000)&#10;api/main.py • Invariant: All endpoints enforce Pydantic v2 schemas and deterministic status returns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="40" y="300" width="1770" height="160" /><mxCell id="p1_gw_sec" value="&lt;b&gt;Security Middleware&lt;/b&gt;&lt;br&gt;• CORS Handler&lt;br&gt;• 512KB Body Size Limiter&lt;br&gt;• Constant-Time HMAC Auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="60" y="350" width="220" height="90" /><mxCell id="p1_r_cal" value="&lt;b&gt;/calendar&lt;/b&gt;&lt;br&gt;GET /weeks&lt;br&gt;GET /stats&lt;br&gt;POST /notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="300" y="350" width="150" height="90" /><mxCell id="p1_r_jrn" value="&lt;b&gt;/journal&lt;/b&gt;&lt;br&gt;GET /today&lt;br&gt;POST /log&lt;br&gt;POST /import (OCR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="470" y="350" width="160" height="90" /><mxCell id="p1_r_gl" value="&lt;b&gt;/goals&lt;/b&gt;&lt;br&gt;GET /horizons&lt;br&gt;POST /goal&lt;br&gt;PATCH /milestone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="650" y="350" width="160" height="90" /><mxCell id="p1_r_coach" value="&lt;b&gt;/coach &amp; /sessions&lt;/b&gt;&lt;br&gt;POST /chat (Streaming)&lt;br&gt;GET /sessions &amp; /messages&lt;br&gt;GET /telemetry &amp; /metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="830" y="350" width="220" height="90" /><mxCell id="p1_r_mem" value="&lt;b&gt;/memories&lt;/b&gt;&lt;br&gt;GET /search (Hybrid RAG)&lt;br&gt;POST /store (Dual-Write)&lt;br&gt;DELETE /purge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1070" y="350" width="190" height="90" /><mxCell id="p1_r_anl" value="&lt;b&gt;/analytics&lt;/b&gt;&lt;br&gt;GET /patterns&lt;br&gt;GET /consistency&lt;br&gt;GET /alignment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1280" y="350" width="160" height="90" /><mxCell id="p1_r_set" value="&lt;b&gt;/settings &amp; /export&lt;/b&gt;&lt;br&gt;GET/PUT /preferences&lt;br&gt;GET /export/json&lt;br&gt;POST /reset/safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1460" y="350" width="180" height="90" /><mxCell id="p1_c3" value="3. COGNITIVE ORCHESTRATION PLANE (Multi-Agent Supervisor &amp; Scoped Toolkits)&#10;ai/pipelines/coordinator.py • Dynamic Tool Scoping (40-50% token reduction &amp; anti-hallucination)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;fontColor=#581C87;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="40" y="490" width="1770" height="190" /><mxCell id="p1_coord" value="&lt;b&gt;CoordinatorAgent&lt;/b&gt;&lt;br&gt;&lt;code&gt;ai/pipelines/coordinator.py&lt;/code&gt;&lt;br&gt;Intent Classifier &amp; Router&lt;br&gt;Specialized Agent Supervisor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="60" y="540" width="240" height="120" /><mxCell id="p1_t_intent" value="&lt;b&gt;Intent Triage Dispatch&lt;/b&gt;&lt;br&gt;• execution → Daily Habits&lt;br&gt;• goals → Milestones &amp; Pacing&lt;br&gt;• memory → Hybrid RAG Search&lt;br&gt;• calendar → 70-Yr Memento Mori" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="320" y="540" width="240" height="120" /><mxCell id="p1_t_journal" value="&lt;b&gt;JournalToolkit&lt;/b&gt;&lt;br&gt;&lt;code&gt;ai/tools/journal_toolkit.py&lt;/code&gt;&lt;br&gt;get_today_tasks()&lt;br&gt;update_habit_log()&lt;br&gt;record_evening_retro()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="580" y="540" width="200" height="120" /><mxCell id="p1_t_goals" value="&lt;b&gt;GoalsToolkit&lt;/b&gt;&lt;br&gt;&lt;code&gt;ai/tools/goals_toolkit.py&lt;/code&gt;&lt;br&gt;query_horizon_goals()&lt;br&gt;advance_milestone()&lt;br&gt;assess_alignment()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="800" y="540" width="200" height="120" /><mxCell id="p1_t_mem" value="&lt;b&gt;MemoryToolkit&lt;/b&gt;&lt;br&gt;&lt;code&gt;ai/tools/memory_toolkit.py&lt;/code&gt;&lt;br&gt;search_semantic_memories()&lt;br&gt;store_user_reflection()&lt;br&gt;fetch_recent_context()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1020" y="540" width="200" height="120" /><mxCell id="p1_t_cal" value="&lt;b&gt;CalendarToolkit&lt;/b&gt;&lt;br&gt;&lt;code&gt;ai/tools/calendar_toolkit.py&lt;/code&gt;&lt;br&gt;get_lifespan_fraction()&lt;br&gt;get_current_week_info()&lt;br&gt;record_weekly_insight()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1240" y="540" width="200" height="120" /><mxCell id="p1_blackboard" value="&lt;b&gt;Blackboard &amp; Telemetry&lt;/b&gt;&lt;br&gt;&lt;code&gt;ObservabilityService&lt;/code&gt;&lt;br&gt;Inter-Agent Context Bus&lt;br&gt;Token &amp; Cost Live Meter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="1460" y="540" width="220" height="120" /><mxCell id="p1_c4" value="4. CORE DOMAIN SERVICES PLANE (Business Logic &amp; Deterministic Calculation Engines)&#10;services/* • 100% Deterministic Core — All scoring runs offline without remote LLMs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;fontColor=#115E59;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="40" y="710" width="1770" height="180" /><mxCell id="p1_s_cal" value="&lt;b&gt;LifeCalendarService&lt;/b&gt;&lt;br&gt;&lt;code&gt;services/life_calendar_service.py&lt;/code&gt;&lt;br&gt;70-Year Memento Mori Matrix&lt;br&gt;Lifespan % &amp; Era Partitioning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="60" y="760" width="240" height="110" /><mxCell id="p1_s_coach" value="&lt;b&gt;CoachService (Rule Fallback)&lt;/b&gt;&lt;br&gt;&lt;code&gt;services/coach_service.py&lt;/code&gt;&lt;br&gt;Deterministic Morning/Evening Rules&lt;br&gt;Zero-Egress Structured Outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="320" y="760" width="250" height="110" /><mxCell id="p1_s_mem" value="&lt;b&gt;MemoryService (Hybrid RAG)&lt;/b&gt;&lt;br&gt;&lt;code&gt;services/memory_service.py&lt;/code&gt;&lt;br&gt;5-Factor Retrieval Composite&lt;br&gt;MMR Cosine Diversity Filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="590" y="760" width="250" height="110" /><mxCell id="p1_s_pat" value="&lt;b&gt;PatternService&lt;/b&gt;&lt;br&gt;&lt;code&gt;services/pattern_service.py&lt;/code&gt;&lt;br&gt;Longitudinal Trend Mining&lt;br&gt;Stalling &amp; Burnout Detectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="860" y="760" width="240" height="110" /><mxCell id="p1_s_anl" value="&lt;b&gt;AnalyticsService&lt;/b&gt;&lt;br&gt;&lt;code&gt;services/analytics_service.py&lt;/code&gt;&lt;br&gt;Habit Consistency Scoring&lt;br&gt;Goal Velocity &amp; Adherence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1120" y="760" width="230" height="110" /><mxCell id="p1_s_ocr" value="&lt;b&gt;JournalImport &amp; LocalOCR&lt;/b&gt;&lt;br&gt;&lt;code&gt;services/journal_import_service.py&lt;/code&gt;&lt;br&gt;OCR Text Ingest &amp; CSV Importers&lt;br&gt;Regex Multi-Block Date Parser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1370" y="760" width="220" height="110" /><mxCell id="p1_s_port" value="&lt;b&gt;DataPortabilityService&lt;/b&gt;&lt;br&gt;&lt;code&gt;services/data_portability_service.py&lt;/code&gt;&lt;br&gt;Atomic JSON Snapshots&lt;br&gt;Safe Backup Before Database Reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1610" y="760" width="180" height="110" /><mxCell id="p1_c5" value="5. DUAL PERSISTENCE PLANE (Local Sovereign Storage @ Local Filesystem)&#10;Invariant: Context managers (with get_db():) • SQLite dictionary rows • Normalized SHA-256 deduplication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="40" y="920" width="1160" height="380" /><mxCell id="p1_sqlite" value="&lt;b&gt;SQLite 3 Database (goalos.db)&lt;/b&gt;&lt;br&gt;&lt;code&gt;database/connection.py &amp; migrations.py&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F1F5F9;strokeColor=#475569;fontColor=#0F172A;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="60" y="980" width="600" height="300" /><mxCell id="p1_sq_tables" value="&lt;b&gt;Relational Tables:&lt;/b&gt;&lt;br&gt;• &lt;code&gt;users&lt;/code&gt; (Profile, dob, remote_ai_consent)&lt;br&gt;• &lt;code&gt;daily_logs&lt;/code&gt; (Habits, morning/evening retros, mood)&lt;br&gt;• &lt;code&gt;goals&lt;/code&gt; (1-mo, 1-yr, 5-yr, category, status)&lt;br&gt;• &lt;code&gt;milestones&lt;/code&gt; (Target dates, weights, completion)&lt;br&gt;• &lt;code&gt;memories&lt;/code&gt; (Raw text, content_hash, importance)&lt;br&gt;• &lt;code&gt;coach_sessions&lt;/code&gt; &amp; &lt;code&gt;coach_messages&lt;/code&gt; (Multi-turn chat)&lt;br&gt;• &lt;code&gt;ai_telemetry&lt;/code&gt; (Tokens, latency_ms, usd_cost)&lt;br&gt;• &lt;code&gt;scores&lt;/code&gt; (Historical consistency indices)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="80" y="1030" width="320" height="230" /><mxCell id="p1_sq_fts5" value="&lt;b&gt;FTS5 Full-Text Search Engine:&lt;/b&gt;&lt;br&gt;• Virtual Table: &lt;code&gt;memory_fts&lt;/code&gt;&lt;br&gt;• Tokenizer: Porter Stemmer + Unicode61&lt;br&gt;• Fast BM25 Lexical Ranking&lt;br&gt;• Synchronized via MemoryService Dual-Write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="420" y="1030" width="220" height="230" /><mxCell id="p1_chroma" value="&lt;b&gt;ChromaDB Vector Store (chroma_db/)&lt;/b&gt;&lt;br&gt;&lt;code&gt;all-MiniLM-L6-v2 Embeddings&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F1F5F9;strokeColor=#475569;fontColor=#0F172A;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="700" y="980" width="480" height="300" /><mxCell id="p1_chroma_details" value="&lt;b&gt;Dense Vector Semantic Engine:&lt;/b&gt;&lt;br&gt;• Embedding Model: &lt;code&gt;all-MiniLM-L6-v2&lt;/code&gt; (384-dim)&lt;br&gt;• Metric: Cosine Distance Space&lt;br&gt;• Collection: &lt;code&gt;goalos_memories&lt;/code&gt;&lt;br&gt;• Index Status Guard: Gracefully sets 'pending' if ChromaDB is locked&lt;br&gt;• Offline Capable: Local PyTorch / ONNX runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="720" y="1030" width="440" height="230" /><mxCell id="p1_c6" value="6. EXTERNAL AI GATEWAY &amp; LOCAL FALLBACK (Zero-Surprise Privacy Boundary)&#10;ai/openrouter_client.py • Hard Consent Gate: No network calls unless user opts-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;fontColor=#581C87;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="1220" y="920" width="590" height="380" /><mxCell id="p1_privacy_gate" value="&lt;b&gt;Local Privacy Consent Guard&lt;/b&gt;&lt;br&gt;Checks &lt;code&gt;remote_ai_consent == True&lt;/code&gt; &amp; Valid API Key&lt;br&gt;Instant divert to local rules if offline or unconsented" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="1240" y="980" width="550" height="70" /><mxCell id="p1_openrouter" value="&lt;b&gt;OpenRouter AI Gateway (Remote LLM)&lt;/b&gt;&lt;br&gt;• Models: Claude 3.5 Sonnet / Llama 3.3 / Gemini 2.5&lt;br&gt;• Free-Tier Leaky-Bucket Limiter (≤14 RPM, ≥4.29s gap)&lt;br&gt;• Auto-Retry: Exponential backoff + jitter on 429/503&lt;br&gt;• Native Tool-Calling &amp; Streaming API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="1240" y="1070" width="280" height="210" /><mxCell id="p1_fallback_engine" value="&lt;b&gt;Local Deterministic Fallback Engine&lt;/b&gt;&lt;br&gt;• 100% Offline Rule Synthesis&lt;br&gt;• Returns structured GoalOS Coach Output&lt;br&gt;• Invariant: &lt;code&gt;source = 'deterministic_rules'&lt;/code&gt;&lt;br&gt;• Zero latency, zero cost, 100% privacy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="1540" y="1070" width="250" height="210" /><mxCell id="e1" value="REST API Calls (Axios JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_api_client" target="p1_gw_sec" /><mxCell id="e2" value="Dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_gw_sec" target="p1_r_coach" /><mxCell id="e3" value="Invoke Supervisor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_r_coach" target="p1_coord" /><mxCell id="e4" value="Triage Intent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_coord" target="p1_t_intent" /><mxCell id="e5" value="Scoped Tool Schema" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_t_intent" target="p1_t_goals" /><mxCell id="e6" value="Execute Domain Logic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_t_goals" target="p1_s_mem" /><mxCell id="e7" value="Consent = True" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_coord" target="p1_privacy_gate" /><mxCell id="e8" value="LLM Prompt &amp; Tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_privacy_gate" target="p1_openrouter" /><mxCell id="e9" value="Consent = False / Offline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_privacy_gate" target="p1_fallback_engine" /><mxCell id="e10" value="Dual-Write (FTS5 + SQLite)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_s_mem" target="p1_sqlite" /><mxCell id="e11" value="Vector Embeddings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p1_s_mem" target="p1_chroma" /></root></mxGraphModel></diagram><diagram id="page2" name="2. Multi-Agent &amp; Tool Loop"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p2_title" value="&lt;b style='font-size:20px; color:#4C1D95;'&gt;🤖 GoalOS — Cognitive Multi-Agent Supervisor &amp; Scoped Tool Loop&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px; color:#475569;'&gt;Dynamic Tool Scoping • Leaky-Bucket Rate Limiter • Non-Blocking Observability &amp; USD Cost Metering&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Plus Jakarta Sans,sans-serif;" vertex="1" parent="1" x="40" y="20" width="1620" height="50" /><mxCell id="p2_user" value="&lt;b&gt;User Input / Chat&lt;/b&gt;&lt;br&gt;Prompt entered in&lt;br&gt;&lt;code&gt;AICoachView.tsx&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="50" y="120" width="160" height="90" /><mxCell id="p2_api" value="&lt;b&gt;POST /coach/chat&lt;/b&gt;&lt;br&gt;FastAPI Gateway validates&lt;br&gt;session ID &amp; auth token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="260" y="120" width="180" height="90" /><mxCell id="p2_session_mgr" value="&lt;b&gt;Session &amp; Blackboard&lt;/b&gt;&lt;br&gt;Loads history from&lt;br&gt;&lt;code&gt;coach_sessions&lt;/code&gt; &amp; &lt;code&gt;coach_messages&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="490" y="120" width="200" height="90" /><mxCell id="p2_supervisor" value="&lt;b&gt;CoordinatorAgent&lt;/b&gt;&lt;br&gt;&lt;code&gt;ai/pipelines/coordinator.py&lt;/code&gt;&lt;br&gt;Supervisor analyzes intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="740" y="100" width="220" height="130" /><mxCell id="p2_box_scoping" value="&lt;b&gt;DYNAMIC DOMAIN TOOL SCOPING&lt;/b&gt;&lt;br&gt;(Token Optimization &amp; Anti-Hallucination Barrier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;fontColor=#581C87;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="1010" y="80" width="650" height="180" /><mxCell id="p2_sc_jrn" value="&lt;b&gt;Journal Scope&lt;/b&gt;&lt;br&gt;get_today_tasks()&lt;br&gt;update_habit_log()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1030" y="140" width="140" height="100" /><mxCell id="p2_sc_gl" value="&lt;b&gt;Goals Scope&lt;/b&gt;&lt;br&gt;query_horizon_goals()&lt;br&gt;advance_milestone()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1190" y="140" width="140" height="100" /><mxCell id="p2_sc_mem" value="&lt;b&gt;Memory Scope&lt;/b&gt;&lt;br&gt;search_hybrid_rag()&lt;br&gt;store_reflection()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1350" y="140" width="140" height="100" /><mxCell id="p2_sc_cal" value="&lt;b&gt;Calendar Scope&lt;/b&gt;&lt;br&gt;get_lifespan_fraction()&lt;br&gt;get_current_week()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1510" y="140" width="130" height="100" /><mxCell id="p2_decision" value="&lt;b&gt;Privacy &amp; Connectivity Check&lt;/b&gt;&lt;br&gt;&lt;code&gt;remote_ai_consent == True&lt;/code&gt;&lt;br&gt;AND &lt;code&gt;OPENROUTER_API_KEY&lt;/code&gt; set?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="710" y="320" width="280" height="100" /><mxCell id="p2_box_remote" value="&lt;b&gt;BRANCH A: REMOTE AGENT PIPELINE (OpenRouter AI)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;fontColor=#581C87;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="50" y="480" width="780" height="460" /><mxCell id="p2_limiter" value="&lt;b&gt;Leaky-Bucket Rate Limiter&lt;/b&gt;&lt;br&gt;• Capacity: 14 RPM (Free Tier Safe)&lt;br&gt;• Min Interval: 4.29 seconds&lt;br&gt;• Jittered Exponential Backoff on 429/503" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="80" y="540" width="320" height="110" /><mxCell id="p2_llm_call" value="&lt;b&gt;OpenRouter Completion Call&lt;/b&gt;&lt;br&gt;• Model: Claude 3.5 Sonnet / Llama 3.3&lt;br&gt;• Injects Scoped Tools &amp; Context&lt;br&gt;• Tool-calling Function Parser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="450" y="540" width="350" height="110" /><mxCell id="p2_tool_exec" value="&lt;b&gt;Tool Dispatch &amp; Execution Loop&lt;/b&gt;&lt;br&gt;• Executes function call against SQLite / Services&lt;br&gt;• Returns JSON tool response to model&lt;br&gt;• Max 3 autonomous tool iterations per turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="450" y="690" width="350" height="110" /><mxCell id="p2_blackboard_update" value="&lt;b&gt;Inter-Agent Blackboard Sync&lt;/b&gt;&lt;br&gt;• Updates dynamic blackboard JSON state&lt;br&gt;• Stores agent reasoning &amp; intermediate flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="80" y="690" width="320" height="110" /><mxCell id="p2_obs" value="&lt;b&gt;Observability &amp; Cost Metering&lt;/b&gt;&lt;br&gt;• Logs prompt_tokens, completion_tokens, latency_ms&lt;br&gt;• Calculates USD spend per call&lt;br&gt;• Emits span to &lt;code&gt;ai_telemetry&lt;/code&gt; table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="80" y="830" width="720" height="80" /><mxCell id="p2_box_local" value="&lt;b&gt;BRANCH B: DETERMINISTIC OFFLINE ENGINE (Zero Egress)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="870" y="480" width="790" height="460" /><mxCell id="p2_rule_engine" value="&lt;b&gt;Local Coach Rule Engine&lt;/b&gt;&lt;br&gt;&lt;code&gt;services/coach_service.py&lt;/code&gt;&lt;br&gt;• Evaluates morning / evening checklists&lt;br&gt;• Calculates goal alignment &amp; habit streaks&lt;br&gt;• Generates structured action recommendations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="900" y="540" width="350" height="140" /><mxCell id="p2_rule_schema" value="&lt;b&gt;Deterministic Schema Guarantee&lt;/b&gt;&lt;br&gt;• Emits valid &lt;code&gt;CoachOutput&lt;/code&gt; Pydantic model&lt;br&gt;• &lt;code&gt;fallback_reason: 'offline_or_unconsented'&lt;/code&gt;&lt;br&gt;• &lt;code&gt;source: 'deterministic_rules'&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1290" y="540" width="340" height="140" /><mxCell id="p2_local_metrics" value="&lt;b&gt;Zero-Cost Local Logging&lt;/b&gt;&lt;br&gt;• 0 tokens consumed • $0.00 spend&lt;br&gt;• Latency &amp;lt; 15ms total execution time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="900" y="720" width="730" height="80" /><mxCell id="p2_response" value="&lt;b&gt;Unified Response Synthesizer &amp; Client Delivery&lt;/b&gt;&lt;br&gt;Appends message to &lt;code&gt;coach_messages&lt;/code&gt; • Returns stream/JSON to &lt;code&gt;AICoachView.tsx&lt;/code&gt; • Renders Action Badges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;fontStyle=1;strokeWidth=1.5;shadow=1;" vertex="1" parent="1" x="300" y="980" width="1100" height="90" /><mxCell id="p2_e1" value="Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_user" target="p2_api" /><mxCell id="p2_e2" value="Validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_api" target="p2_session_mgr" /><mxCell id="p2_e3" value="Active Context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_session_mgr" target="p2_supervisor" /><mxCell id="p2_e4" value="Filter Tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_supervisor" target="p2_box_scoping" /><mxCell id="p2_e5" value="Check Policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_supervisor" target="p2_decision" /><mxCell id="p2_e6" value="YES (Remote AI)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_decision" target="p2_limiter" /><mxCell id="p2_e7" value="NO (Local Safe)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_decision" target="p2_rule_engine" /><mxCell id="p2_e8" value="Paced Tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_limiter" target="p2_llm_call" /><mxCell id="p2_e9" value="Tool Calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_llm_call" target="p2_tool_exec" /><mxCell id="p2_e10" value="Tool Result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_tool_exec" target="p2_llm_call" /><mxCell id="p2_e11" value="Sync State" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_tool_exec" target="p2_blackboard_update" /><mxCell id="p2_e12" value="Span Telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_llm_call" target="p2_obs" /><mxCell id="p2_e13" value="Deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_obs" target="p2_response" /><mxCell id="p2_e14" value="Deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p2_rule_schema" target="p2_response" /></root></mxGraphModel></diagram><diagram id="page3" name="3. Hybrid RAG &amp; Memory Pipeline"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p3_title" value="&lt;b style='font-size:20px; color:#065F46;'&gt;🧠 GoalOS — Cognitive Memory Dual-Write &amp; 5-Factor Hybrid RAG Pipeline&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px; color:#475569;'&gt;SHA-256 Deduplication • FTS5 BM25 Lexical + ChromaDB Cosine Semantic • 5-Factor Retrieval Composite • MMR Diversity Filter&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Plus Jakarta Sans,sans-serif;" vertex="1" parent="1" x="40" y="20" width="1620" height="50" /><mxCell id="p3_c_ingest" value="&lt;b&gt;MEMORY INGESTION &amp; DUAL-WRITE PIPELINE (Invariant 1.3)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;fontColor=#115E59;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="40" y="90" width="1620" height="320" /><mxCell id="p3_raw_in" value="&lt;b&gt;Raw Memory Capture&lt;/b&gt;&lt;br&gt;• Daily Reflection Note&lt;br&gt;• Coach Dialogue Insight&lt;br&gt;• Milestone Breakthrough" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="60" y="150" width="210" height="100" /><mxCell id="p3_hash" value="&lt;b&gt;SHA-256 Deduplication Hash&lt;/b&gt;&lt;br&gt;&lt;code&gt;hashlib.sha256(&quot; &quot;.join(text.casefold().split()))&lt;/code&gt;&lt;br&gt;Prevents duplicate memory blobs across syncs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="310" y="150" width="300" height="100" /><mxCell id="p3_dual_write_hub" value="&lt;b&gt;MemoryService.store() Transaction Coordinator&lt;/b&gt;&lt;br&gt;Coordinates Atomic SQLite insert, FTS5 sync, and vector embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="650" y="150" width="360" height="100" /><mxCell id="p3_w_sq" value="&lt;b&gt;1. Relational Record&lt;/b&gt;&lt;br&gt;Upsert into &lt;code&gt;memories&lt;/code&gt; table&lt;br&gt;(id, text, content_hash, importance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="1050" y="130" width="260" height="75" /><mxCell id="p3_w_fts5" value="&lt;b&gt;2. FTS5 Indexing&lt;/b&gt;&lt;br&gt;Upsert into &lt;code&gt;memory_fts&lt;/code&gt;&lt;br&gt;(Porter Stemmer &amp; BM25 Ready)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="1050" y="220" width="260" height="75" /><mxCell id="p3_w_chroma" value="&lt;b&gt;3. ChromaDB Vector Upsert&lt;/b&gt;&lt;br&gt;Embed with &lt;code&gt;all-MiniLM-L6-v2&lt;/code&gt;&lt;br&gt;If locked, sets &lt;code&gt;index_status = 'pending'&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="1340" y="175" width="290" height="85" /><mxCell id="p3_c_retrieval" value="&lt;b&gt;5-FACTOR HYBRID RAG RETRIEVAL &amp; MMR FILTERING (Invariant 3.1)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;fontColor=#581C87;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="40" y="440" width="1620" height="750" /><mxCell id="p3_query_in" value="&lt;b&gt;Retrieval Query&lt;/b&gt;&lt;br&gt;Incoming User Query or Coach Context&lt;br&gt;&lt;code&gt;MemoryService.retrieve(query, top_k=5)&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="60" y="510" width="280" height="90" /><mxCell id="p3_par_search" value="&lt;b&gt;Parallel Dual-Search Execution&lt;/b&gt;&lt;br&gt;Concurrent Lexical BM25 and Dense Vector Similarity Queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;strokeWidth=1.2;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;" vertex="1" parent="1" x="380" y="510" width="340" height="90" /><mxCell id="p3_lex_res" value="&lt;b&gt;Lexical Search (FTS5)&lt;/b&gt;&lt;br&gt;BM25 Ranking Score&lt;br&gt;Exact terms &amp; code tokens&lt;br&gt;Normalized Score: &lt;b&gt;S_lex&lt;/b&gt; (capped 1.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="760" y="480" width="270" height="95" /><mxCell id="p3_sem_res" value="&lt;b&gt;Semantic Search (ChromaDB)&lt;/b&gt;&lt;br&gt;Cosine Similarity Score&lt;br&gt;Concept &amp; synonym matching&lt;br&gt;Normalized Score: &lt;b&gt;S_sem&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="760" y="600" width="270" height="95" /><mxCell id="p3_formula_box" value="&lt;b&gt;GOALOS 5-FACTOR RETRIEVAL FORMULA&lt;/b&gt;&lt;br&gt;&lt;div style='font-size:13px; font-family:monospace; color:#064E3B; background:#ECFDF5; padding:8px; border-radius:6px; margin:6px 0;'&gt;S = 0.35·S_sem + 0.15·S_lex + 0.25·S_imp + 0.15·S_rec + 0.10·S_freq&lt;/div&gt;• &lt;b&gt;S_sem (35%):&lt;/b&gt; Dense Cosine Similarity from ChromaDB&lt;br&gt;• &lt;b&gt;S_lex (15%):&lt;/b&gt; BM25 Lexical Keyword Match from SQLite FTS5&lt;br&gt;• &lt;b&gt;S_imp (25%):&lt;/b&gt; Normalized Importance Level (1 to 5 scale)&lt;br&gt;• &lt;b&gt;S_rec (15%):&lt;/b&gt; 30-Day Exponential Half-Life Decay: &lt;code&gt;exp(-0.693 · Δt / 30)&lt;/code&gt;&lt;br&gt;• &lt;b&gt;S_freq (10%):&lt;/b&gt; Logarithmic Access Frequency: &lt;code&gt;min(1.0, ln(1 + n) / ln(100))&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="1070" y="480" width="560" height="220" /><mxCell id="p3_mmr_box" value="&lt;b&gt;Maximal Marginal Relevance (MMR) Diversity Filter&lt;/b&gt;&lt;br&gt;• Cosine Similarity Threshold: &lt;b&gt;cos(v_i, v_selected) &amp;lt; 0.94&lt;/b&gt;&lt;br&gt;• Rejects redundant near-duplicate memories (e.g. repeated daily habit notes)&lt;br&gt;• Maximizes information entropy in LLM prompt window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;strokeWidth=1.5;shadow=0;" vertex="1" parent="1" x="760" y="740" width="870" height="110" /><mxCell id="p3_final_context" value="&lt;b&gt;Ranked Cognitive Context Assembly&lt;/b&gt;&lt;br&gt;• Top 3-5 Diverse, Highly Relevant, Grounded Memories&lt;br&gt;• Injected into System Prompt with Exact Timestamp &amp; Citation IDs&lt;br&gt;• Enforces Zero-Hallucination Invariant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;shadow=1;fontFamily=Plus Jakarta Sans,sans-serif;fontSize=11;fontStyle=1;" vertex="1" parent="1" x="760" y="890" width="870" height="90" /><mxCell id="p3_e1" value="Capture" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_raw_in" target="p3_hash" /><mxCell id="p3_e2" value="Verified Hash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_hash" target="p3_dual_write_hub" /><mxCell id="p3_e3" value="Write Relational" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_dual_write_hub" target="p3_w_sq" /><mxCell id="p3_e4" value="Write Lexical" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_dual_write_hub" target="p3_w_fts5" /><mxCell id="p3_e5" value="Write Vector" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_dual_write_hub" target="p3_w_chroma" /><mxCell id="p3_e6" value="Search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_query_in" target="p3_par_search" /><mxCell id="p3_e7" value="FTS5 Query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_par_search" target="p3_lex_res" /><mxCell id="p3_e8" value="Cosine Query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_par_search" target="p3_sem_res" /><mxCell id="p3_e9" value="Feed S_lex" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_lex_res" target="p3_formula_box" /><mxCell id="p3_e10" value="Feed S_sem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_sem_res" target="p3_formula_box" /><mxCell id="p3_e11" value="Scored Candidates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=10;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_formula_box" target="p3_mmr_box" /><mxCell id="p3_e12" value="Deduplicated" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#5B21B6;fontSize=10;fontStyle=1;fontFamily=Plus Jakarta Sans,sans-serif;" edge="1" parent="1" source="p3_mmr_box" target="p3_final_context" /></root></mxGraphModel></diagram></mxfile>